{
  "schema": "mpsim.presets/1",
  "presets": [
    {"id": "emc_silica", "name": "EMC · epoxy + fused silica 50 vol%",
     "description": "Semiconductor mould compound. Spherical silica with a log-normal size distribution governs the CTE and the thermal conductivity.",
     "form": {"name": "EMC · epoxy + SiO₂ 50 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "sio2", "name": "Fused silica", "shape": "sphere", "size": {"d": 20, "unit": "um"},
                  "dist": {"type": "lognormal", "cv": 0.25}, "fraction": {"value": 50, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"thermal": true, "cte": true, "dielectric": true, "morphology": true, "grains": true},
      "options": {"directions": "xyz", "delta_T": 100}}},

    {"id": "underfill", "name": "Underfill · epoxy + SiO₂ 40 vol% (1 µm)",
     "description": "Flip-chip underfill; the objective is CTE matching with the solder bumps.",
     "form": {"name": "Underfill · epoxy + SiO₂ 40 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "sio2", "name": "SiO₂", "shape": "sphere", "size": {"d": 1, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 40, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"thermal": true, "cte": true, "dielectric": true},
      "options": {"directions": "xyz", "delta_T": 100}}},

    {"id": "tim_al2o3", "name": "TIM · silicone + Al₂O₃ 50 vol% with interfacial resistance",
     "description": "Thermal gap filler. The interfacial (Kapitza) resistance introduces a filler-size effect.",
     "form": {"name": "TIM · silicone + Al₂O₃ 50 vol%",
      "matrix": {"material_id": "silicone"},
      "phases": [{"material_id": "al2o3", "name": "Al₂O₃", "shape": "sphere", "size": {"d": 5, "unit": "um"},
                  "dist": {"type": "lognormal", "cv": 0.25}, "fraction": {"value": 50, "basis": "vol"},
                  "orientation": {"mode": "iso"}, "r_int": 1e-8}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"thermal": true, "grains": true},
      "options": {"directions": "xyz", "thickness_mm": 0.2}}},

    {"id": "tim_aln", "name": "TIM · epoxy + AlN 40 vol%",
     "description": "High-conductivity epoxy composite. The large filler contrast makes the matrix films between particles govern k.",
     "form": {"name": "TIM · epoxy + AlN 40 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "aln", "name": "AlN", "shape": "sphere", "size": {"d": 1, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 40, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"thermal": true, "cte": true, "grains": true},
      "options": {"directions": "xyz", "delta_T": 100, "thickness_mm": 0.1}}},

    {"id": "bn_sheet", "name": "Thermal sheet · silicone + h-BN platelets 25 vol% (in-plane aligned)",
     "description": "Platelets lying in the xy plane produce very different in-plane and through-plane conductivities.",
     "form": {"name": "Silicone + h-BN platelets 25 vol%",
      "matrix": {"material_id": "silicone"},
      "phases": [{"material_id": "hbn", "name": "h-BN platelet", "shape": "spheroid", "size": {"d": 12, "aspect": 0.15, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 25, "basis": "vol"}, "orientation": {"mode": "z", "spread_deg": 10}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"thermal": true, "grains": true},
      "options": {"directions": "xyz", "thickness_mm": 0.3}}},

    {"id": "lowk_porous", "name": "Porous low-k film · SiO₂ + 30 % connected porosity",
     "description": "Mesoporous silica low-k dielectric; permittivity, stiffness, thermal conductivity with rarefied gas in the nanopores, and the pore-entry size distribution.",
     "form": {"name": "Porous low-k · SiO₂ + 30 % open pores",
      "matrix": {"material_id": "sio2"},
      "phases": [{"material_id": "air", "name": "Pores", "shape": "network", "size": {"d": 5, "unit": "nm"},
                  "fraction": {"value": 30, "basis": "vol"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"dielectric": true, "thermal": true, "cte": true, "morphology": true, "porosimetry": true},
      "options": {"directions": "xyz", "delta_T": 100, "knudsen": true, "thickness_mm": 0.0003}}},

    {"id": "sinter_ag", "name": "Sintered silver die attach · Ag + 15 % porosity",
     "description": "Power-module die attach; reduction of thermal and electrical conductivity and stiffness by porosity.",
     "form": {"name": "Sintered Ag · 15 % porosity",
      "matrix": {"material_id": "ag"},
      "phases": [{"material_id": "air", "name": "Pores", "shape": "network", "size": {"d": 0.5, "unit": "um"},
                  "fraction": {"value": 15, "basis": "vol"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"thermal": true, "electrical": true, "cte": true, "morphology": true},
      "options": {"directions": "xyz", "delta_T": 100, "thickness_mm": 0.05}}},

    {"id": "eca_ag_flake", "name": "Conductive adhesive · epoxy + Ag flakes 20 vol%",
     "description": "Oblate spheroids (thickness/diameter 0.15) aligned in plane; in-plane and through-plane percolation are compared.",
     "form": {"name": "ECA · epoxy + Ag flakes 20 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "ag", "name": "Ag flake", "shape": "spheroid", "size": {"d": 10, "aspect": 0.15, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 20, "basis": "vol"}, "orientation": {"mode": "z", "spread_deg": 15},
                  "overlap": true}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"electrical": true, "thermal": true, "grains": true, "percolation": true},
      "options": {"directions": "xyz", "thickness_mm": 0.03}}},

    {"id": "emi_ni_rod", "name": "EMI shielding · epoxy + Ni rods 12 vol%",
     "description": "Magnetic metal rods; electrical percolation and permeability determine the shielding effectiveness.",
     "form": {"name": "EMI · epoxy + Ni rods 12 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "ni", "name": "Ni rod", "shape": "spherocylinder", "size": {"d": 2, "length": 16, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 12, "basis": "vol"}, "orientation": {"mode": "iso"}, "overlap": true}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"emi": true, "thermal": true, "grains": true},
      "options": {"directions": "xyz", "emi": {"thickness_mm": 1.0, "f_min_hz": 1e6, "f_max_hz": 1e10}}}},

    {"id": "lowdk_hollow", "name": "Low-Dk substrate · PPE + hollow silica 30 vol%",
     "description": "Hollow silica (0.3 µm shell) lowers Dk; the shell thickness sets the required resolution.",
     "form": {"name": "Low-Dk · PPE + hollow silica 30 vol%",
      "matrix": {"material_id": "ppe"},
      "phases": [{"material_id": "air", "name": "Hollow silica", "shape": "sphere", "size": {"d": 3, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 30, "basis": "vol"}, "orientation": {"mode": "iso"},
                  "shell": {"enabled": true, "thickness": 0.3, "material_id": "sio2", "name": "SiO₂ shell"}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"dielectric": true, "thermal": true, "cte": true},
      "options": {"directions": "xyz", "delta_T": 100, "thickness_mm": 0.05}}},

    {"id": "nte_epoxy", "name": "Low CTE · epoxy + ZrW₂O₈ 40 vol%",
     "description": "Negative-thermal-expansion filler lowering the composite CTE (conditions of the NTE study).",
     "form": {"name": "Low CTE · epoxy + ZrW₂O₈ 40 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "zrw2o8", "name": "ZrW₂O₈", "shape": "sphere", "size": {"d": 500, "unit": "nm"},
                  "dist": {"type": "mono"}, "fraction": {"value": 40, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"cte": true, "thermal": true},
      "options": {"directions": "xyz", "delta_T": 100}}},

    {"id": "highk_batio3", "name": "High-k · epoxy + BaTiO₃ 30 vol%",
     "description": "Embedded-capacitor dielectric. The ferroelectric filler contrast makes the inter-particle distance govern Dk and the local field enhancement.",
     "form": {"name": "High-k · epoxy + BaTiO₃ 30 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "batio3", "name": "BaTiO₃", "shape": "sphere", "size": {"d": 0.5, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 30, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": true, "quality": "standard"},
      "analyses": {"dielectric": true, "grains": true},
      "options": {"directions": "xyz", "thickness_mm": 0.01}}},

    {"id": "porous_filter", "name": "Porous ceramic · Al₂O₃ + 35 % porosity (vacuum chuck, filter)",
     "description": "Porous chuck and filter ceramics: permeability, tortuosity, intrusion porosimetry, pore network, radiative extinction and thermal conductivity in one run.",
     "form": {"name": "Porous Al₂O₃ · 35 % open pores",
      "matrix": {"material_id": "al2o3"},
      "phases": [{"material_id": "air", "name": "Pores", "shape": "network", "size": {"d": 2, "unit": "um"},
                  "fraction": {"value": 35, "basis": "vol"}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"permeability": true, "tortuosity": true, "morphology": true, "thermal": true,
                   "porosimetry": true, "pore_network": true, "radiation": true, "percolation": true},
      "options": {"directions": "xyz", "radiation": {"temperature_K": 1000}}}},

    {"id": "ptfe_membrane", "name": "UPW filter membrane · PTFE + 70 % porosity (bubble point)",
     "description": "Wet-process filter membrane: largest through-pore and isopropanol bubble point, flow resistance, tortuosity and pore network.",
     "form": {"name": "PTFE membrane · 70 % porosity",
      "matrix": {"material_id": "ptfe"},
      "phases": [{"material_id": "air", "name": "Pores", "shape": "network", "size": {"d": 0.2, "unit": "um"},
                  "fraction": {"value": 70, "basis": "vol"}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"permeability": true, "tortuosity": true, "porosimetry": true, "pore_network": true,
                   "morphology": true, "percolation": true},
      "options": {"directions": "xyz", "porosimetry": {"fluid": "isopropanol"}, "thickness_mm": 0.05}}},

    {"id": "sus_filter", "name": "Sintered gas filter · SUS316L + 40 % porosity",
     "description": "Point-of-use gas filter: permeability, pore-entry size, bubble point, filtration efficiency, pore network and thermal conductivity of sintered stainless steel.",
     "form": {"name": "Sintered SUS316L · 40 % porosity",
      "matrix": {"material_id": "sus316l"},
      "phases": [{"material_id": "air", "name": "Pores", "shape": "network", "size": {"d": 5, "unit": "um"},
                  "fraction": {"value": 40, "basis": "vol"}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"permeability": true, "filtration": true, "porosimetry": true, "pore_network": true, "thermal": true},
      "options": {"directions": "xyz", "porosimetry": {"fluid": "isopropanol"}, "thickness_mm": 2.0}}},

    {"id": "fibre_insulation", "name": "Fibrous insulation · E-glass fibres 8 vol% in air",
     "description": "Equipment insulation and acoustic lining: fibres lying in the xy plane; thermal conductivity, sound absorption (JCA) and radiative extinction.",
     "form": {"name": "Glass-fibre insulation · 8 vol%",
      "matrix": {"material_id": "air"},
      "phases": [{"material_id": "eglass", "name": "Glass fibre", "shape": "cylinder", "size": {"d": 8, "length": 80, "unit": "um"},
                  "dist": {"type": "mono"}, "fraction": {"value": 8, "basis": "vol"}, "orientation": {"mode": "xy", "spread_deg": 10},
                  "overlap": true}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"thermal": true, "acoustics": true, "radiation": true, "morphology": true},
      "options": {"directions": "xz", "acoustics": {"thickness_mm": 25, "f_min_hz": 100, "f_max_hz": 10000},
                  "radiation": {"temperature_K": 600}, "thickness_mm": 25}}},

    {"id": "muf_bimodal", "name": "MUF · epoxy + silica 15 + 3 µm 55 vol% (flowability)",
     "description": "Moulded underfill before cure: effective viscosity, flow curve, maximum packing fraction, capillary filling of a 50 µm bump gap and filler settling. Replace the two silica phases with one 5 µm phase to see why the bimodal blend flows about twice as easily (guide 32.1). Fast quality, as in the guide: at this loading the best value comes from Krieger–Dougherty with the computed maximum packing.",
     "form": {"name": "MUF · silica 15 + 3 µm 55 vol%",
      "matrix": {"material_id": "epoxy", "name": "MUF epoxy resin"},
      "phases": [{"material_id": "sio2", "name": "Silica 15 µm", "shape": "sphere", "size": {"d": 15, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 38.5, "basis": "vol"}, "orientation": {"mode": "iso"}},
                 {"material_id": "sio2", "name": "Silica 3 µm", "shape": "sphere", "size": {"d": 3, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 16.5, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": false, "L_um": 60, "voxel_um": 0.5, "quality": "fast"},
      "analyses": {"viscosity": true},
      "options": {"viscosity": {"model": {"type": "carreau", "mu0": 2, "mu_inf": 0.2, "lam": 0.05, "n": 0.6}, "gd_min": 0.1, "gd_max": 1000, "gd_ref": 10, "phi_m_mode": "auto", "friction": "none", "density_resin": 1150, "settle_min": 30, "underfill": {"gap_um": 50, "length_mm": 10, "gamma_mN_m": 35, "theta_deg": 30}}}}},

    {"id": "emc_reliability", "name": "EMC reliability · epoxy + silica 40 vol% (moisture, swelling, above Tg)",
     "description": "Moisture diffusivity, saturated uptake, the uptake curve of a 0.5 mm part at 85 °C / 85 % RH and the hygroscopic swelling (CME), together with the CTE and modulus below and above the glass transition (α1 / α2) of a moulding compound (guide chapter 14).",
     "form": {"name": "EMC · epoxy + silica 40 vol% (reliability)",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "sio2", "name": "Fused silica", "shape": "sphere", "size": {"d": 4, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 40, "basis": "vol"}, "orientation": {"mode": "iso"}}],
      "rve": {"auto": false, "L_um": 28.5, "voxel_um": 0.285, "quality": "standard"},
      "analyses": {"cte": true, "moisture": true},
      "options": {"directions": "zx", "above_tg": true, "moisture": {"thickness_mm": 0.5, "hours": 168, "sides": "both"}}}},

    {"id": "film_pi_bn", "name": "Thin film · polyimide + h-BN platelets 25 vol%, 15 µm",
     "description": "A 15 µm film: x and y periodic, z the real thickness, every platelet inside the film. The platelets lie in the plane, so the in-plane thermal conductivity is about twice the through-plane value that a heat-spreading film is judged by (guide 6.5).",
     "form": {"name": "Film · polyimide + h-BN 25 vol%, 15 µm",
      "matrix": {"material_id": "polyimide"},
      "phases": [{"material_id": "hbn", "name": "h-BN platelet", "shape": "spheroid", "size": {"d": 6, "aspect": 0.25, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 25, "basis": "vol"}, "orientation": {"mode": "z", "spread_deg": 10}}],
      "rve": {"auto": true, "quality": "standard", "film": true, "T_um": 15},
      "analyses": {"thermal": true, "dielectric": true},
      "options": {"directions": "xyz", "thickness_mm": 0.015}}},

    {"id": "nss_sendust", "name": "Noise-suppression sheet · epoxy + Sendust flakes 25 vol% (permeability)",
     "description": "Flat magnetic flakes lying in the plane of the sheet: the in-plane permeability is about two and a half times the through-plane value, because the flux crosses fewer resin gaps (guide chapter 10). Compare with spheres of the same content.",
     "form": {"name": "Sheet · epoxy + Sendust flakes 25 vol%",
      "matrix": {"material_id": "epoxy"},
      "phases": [{"material_id": "sendust", "name": "Sendust flake", "shape": "spheroid", "size": {"d": 10, "aspect": 0.2, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 25, "basis": "vol"}, "orientation": {"mode": "z", "spread_deg": 10}}],
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"magnetic": true, "grains": true},
      "options": {"directions": "xyz", "thickness_mm": 0.1}}},

    {"id": "tim_hybrid", "name": "Hybrid TIM · silicone + Al₂O₃ 10 µm + AlN 3 µm 55 vol% (blend, contacts)",
     "description": "Two fillers of different size and material: the small AlN fills the gaps between the large Al₂O₃. Each filler has its own interfacial resistance, and the contact resistance between the two fillers is set separately (Structure tab). Particles may touch, as in a real gap filler; Fast quality keeps the run short - use Standard for values to report.",
     "form": {"name": "Hybrid TIM · Al₂O₃ 10 µm + AlN 3 µm",
      "matrix": {"material_id": "silicone"},
      "phases": [{"material_id": "al2o3", "name": "Al₂O₃ 10 µm", "shape": "sphere", "size": {"d": 10, "unit": "um"}, "dist": {"type": "lognormal", "cv": 0.2}, "fraction": {"value": 40, "basis": "vol"}, "orientation": {"mode": "iso"}, "r_int": 1e-08, "r_contact": 2e-08},
                 {"material_id": "aln", "name": "AlN 3 µm", "shape": "sphere", "size": {"d": 3, "unit": "um"}, "dist": {"type": "mono"}, "fraction": {"value": 15, "basis": "vol"}, "orientation": {"mode": "iso"}, "r_int": 1e-08, "r_contact": 2e-08}],
      "contact_rc": {"0-1": 3e-08},
      "rve": {"auto": true, "quality": "fast"},
      "analyses": {"thermal": true, "grains": true, "percolation": true},
      "options": {"directions": "xyz", "thickness_mm": 0.2, "contacts": "keep"}}}
  ]
}
